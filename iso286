"use client";
import React, { useState, useEffect } from "react";

export default function Iso286FitAnalysis() {
  const [nominalDiameter, setNominalDiameter] = useState(50);
  const [holeTolerance, setHoleTolerance] = useState("H7");
  const [shaftTolerance, setShaftTolerance] = useState("h6");
  const [fitResult, setFitResult] = useState(null);
  const [error, setError] = useState("");

  // --- Example tolerance data (you will need to fill in the real ISO 286 values) ---
  const toleranceData = {
    hole: {
      H7: { "10-18": { upper: 21, lower: 0 }, "18-30": { upper: 25, lower: 0 } },
    },
    shaft: {
      h6: { "10-18": { upper: 0, lower: -10 }, "18-30": { upper: 0, lower: -13 } },
    },
  };

  const ranges = [
    "1-3","3-6","6-10","10-18","18-30","30-40","40-50","50-65","65-80","80-100","100-120","120-140",
    "140-160","160-180","180-200","200-225","225-250","250-280","280-315","315-355","355-400","400-450","450-500",
  ];
  const limits = [1,3,6,10,18,30,40,50,65,80,100,120,140,160,180,200,225,250,280,315,355,400,450,500];

  function getSizeRange(diameter) {
    for (let i = 0; i < limits.length - 1; i++) {
      if (diameter > limits[i] && diameter <= limits[i + 1]) return ranges[i];
    }
    return "450-500";
  }

  function calculateFit() {
    setError("");
    const range = getSizeRange(nominalDiameter);
    const holeValues = toleranceData.hole[holeTolerance]?.[range];
    const shaftValues = toleranceData.shaft[shaftTolerance]?.[range];

    if (!holeValues || !shaftValues) {
      setError("Données de tolérance non disponibles pour cette combinaison.");
      return;
    }

    const holeMax = nominalDiameter + holeValues.upper / 1000;
    const holeMin = nominalDiameter + holeValues.lower / 1000;
    const shaftMax = nominalDiameter + shaftValues.upper / 1000;
    const shaftMin = nominalDiameter + shaftValues.lower / 1000;

    const maxClearance = holeMax - shaftMin;
    const minClearance = holeMin - shaftMax;

    let fitType = "";
    let fitClass = "";

    if (minClearance > 0) {
      fitType = "Ajustement avec jeu";
      fitClass = "bg-green-200/20 border border-green-400/40 text-green-300";
    } else if (maxClearance < 0) {
      fitType = "Ajustement avec serrage";
      fitClass = "bg-red-200/20 border border-red-400/40 text-red-300";
    } else {
      fitType = "Ajustement de transition";
      fitClass = "bg-amber-200/20 border border-amber-400/40 text-amber-300";
    }

    setFitResult({
      hole: { ...holeValues, max: holeMax, min: holeMin },
      shaft: { ...shaftValues, max: shaftMax, min: shaftMin },
      fitType,
      fitClass,
      clearance: { max: maxClearance, min: minClearance },
    });
  }

  useEffect(() => {
    calculateFit();
  }, []);

  return (
    <div className="min-h-screen flex flex-col items-center justify-center bg-gradient-to-br from-[#b01614] via-gray-600 to-gray-900 text-white p-8">
      <div className="max-w-6xl w-full backdrop-blur-lg bg-white/10 rounded-2xl shadow-2xl border border-white/20 p-8">
        <header className="text-center mb-10">
          <h1 className="text-4xl font-bold tracking-wide text-white drop-shadow-lg">
            Analyse des Ajustements ISO 286
          </h1>
          <p className="text-gray-300 mt-2 text-lg">
            Calculateur de tolérances et d'ajustements arbre/alésage
          </p>
        </header>

        <div className="flex flex-col lg:flex-row gap-8">
          {/* Controls Section */}
          <div className="flex-1 backdrop-blur-md bg-white/10 rounded-xl p-6 border border-white/10 shadow-inner">
            <div className="space-y-6">
              <div>
                <label className="block font-semibold mb-2 text-gray-200">
                  Diamètre nominal (mm)
                </label>
                <input
                  type="number"
                  value={nominalDiameter}
                  onChange={(e) => setNominalDiameter(parseFloat(e.target.value))}
                  className="w-full p-3 rounded-md bg-white/20 text-white border border-white/20 focus:ring-2 focus:ring-red-400"
                  min="1"
                  max="500"
                  step="0.1"
                />
              </div>

              <div>
                <label className="block font-semibold mb-2 text-gray-200">
                  Code de tolérance de l'alésage
                </label>
                <select
                  value={holeTolerance}
                  onChange={(e) => setHoleTolerance(e.target.value)}
                  className="w-full p-3 rounded-md bg-white/20 text-white border border-white/20"
                >
                  {Object.keys(toleranceData.hole).map((key) => (
                    <option key={key} value={key} className="text-black">
                      {key}
                    </option>
                  ))}
                </select>
              </div>

              <div>
                <label className="block font-semibold mb-2 text-gray-200">
                  Code de tolérance de l'arbre
                </label>
                <select
                  value={shaftTolerance}
                  onChange={(e) => setShaftTolerance(e.target.value)}
                  className="w-full p-3 rounded-md bg-white/20 text-white border border-white/20"
                >
                  {Object.keys(toleranceData.shaft).map((key) => (
                    <option key={key} value={key} className="text-black">
                      {key}
                    </option>
                  ))}
                </select>
              </div>

              <button
                onClick={calculateFit}
                className="w-full bg-gradient-to-r from-red-500 to-red-700 text-white py-3 rounded-lg font-semibold shadow-md hover:shadow-xl transition"
              >
                Calculer l'ajustement
              </button>

              {error && (
                <div className="bg-red-900/50 border border-red-500/40 text-red-200 p-3 rounded-md">
                  {error}
                </div>
              )}
            </div>
          </div>

          {/* Results Section */}
          <div className="flex-[2] space-y-6">
            {fitResult && (
              <>
                <div className="backdrop-blur-md bg-white/10 rounded-xl p-6 border border-white/10">
                  <h2 className="text-xl font-semibold text-red-300 mb-4">
                    Résultats de l'analyse d'ajustement
                  </h2>

                  <div
                    className={`p-4 mt-4 text-center font-semibold rounded-md ${fitResult.fitClass}`}
                  >
                    {fitResult.fitType}
                  </div>

                  <div className="mt-4 grid grid-cols-2 gap-2 text-gray-200">
                    <div>Diamètre nominal :</div>
                    <div>{nominalDiameter.toFixed(3)} mm</div>
                    <div>Jeu max :</div>
                    <div>{fitResult.clearance.max.toFixed(3)} mm</div>
                    <div>Jeu min :</div>
                    <div>{fitResult.clearance.min.toFixed(3)} mm</div>
                  </div>
                </div>

                <div className="backdrop-blur-md bg-white/10 rounded-xl p-6 border border-white/10">
                  <h2 className="text-xl font-semibold text-blue-300 mb-4">
                    Visualisation des zones de tolérance
                  </h2>
                  <div className="relative h-16 w-full bg-gray-800/40 rounded-lg overflow-hidden">
                    <div
                      className="absolute top-2 h-3 bg-blue-400/60 rounded"
                      style={{
                        left: "35%",
                        width: "30%",
                      }}
                    ></div>
                    <div
                      className="absolute bottom-2 h-3 bg-red-400/60 rounded"
                      style={{
                        left: "40%",
                        width: "20%",
                      }}
                    ></div>
                    <div className="absolute left-1/2 w-[2px] bg-white/70 h-full" />
                  </div>
                  <div className="flex justify-between mt-2 text-xs text-gray-300">
                    <span>Min</span>
                    <span>Ligne zéro (nominal)</span>
                    <span>Max</span>
                  </div>
                </div>
              </>
            )}
          </div>
        </div>

        <footer className="text-center mt-10 text-gray-400 text-sm border-t border-white/10 pt-4">
          Outil d'analyse des ajustements ISO 286 © 2025 | Interface scientifique moderne
        </footer>
      </div>
    </div>
  );
}
